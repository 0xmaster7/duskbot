# link service (npm start). names only; set values in the deploy env file, never in the repo.
PORT=8790
HOST=127.0.0.1
LINK_BASE=https://link.dusk.bot
LINK_DATA_DIR=
LINK_PACKAGES_DIR=
LINK_TRUST_PROXY=1
# advertised at /.well-known/duskbot/dashboard
DUSK_LINK_DASHBOARD_URL=
# link grants: unset trusts the pinned account service key; DUSK_LINK_OPEN=1 drops the account check (development only)
DUSK_LINK_GRANT_KEYS=
DUSK_LINK_OPEN=
# phone push relay (docs/phone-push.md); unset means that service is off
DUSK_APNS_KEY_FILE=
DUSK_APNS_KEY_ID=
DUSK_APNS_TEAM_ID=
DUSK_APNS_TOPIC=
DUSK_FCM_SERVICE_ACCOUNT_FILE=
