# Edge for one My Cloud home on a Boat sandbox (apps/cloud-service/docs/provider.md). Boat's hosted-port proxy terminates TLS for
# <subdomain>-8080.on.boat.dev and reaches this machine on :8080. The OpenMausBot server listens only on 127.0.0.1, and
# every request forwarded to it carries X-Forwarded-*, so it is never the loopback owner (server/request-auth.ts): a
# remote client needs a paired session.
#
# OMB_CLOUD_EDGE_HOLD: how long a request waits for the server while it starts after a resume, instead of a 502.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# Only these peers may name the real client, in this header (the launcher sets both:
		# server/cloud-home-start.ts). The address feeds the pairing lockout, never authorization.
		trusted_proxies static {$OMB_CLOUD_EDGE_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers {$OMB_CLOUD_EDGE_CLIENT_IP_HEADER}
	}
}

:8080 {
	encode zstd gzip

	handle /api/health {
		reverse_proxy 127.0.0.1:8799 {
			lb_try_duration {$OMB_CLOUD_EDGE_HOLD:0s}
			lb_try_interval 50ms
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Everything else answers only for this machine's own public name.
	@home host {$OMB_CLOUD_PUBLIC_HOST}
	handle @home {
		# Webhook ingress has its own per-hook secrets.
		handle /hooks/* {
			reverse_proxy 127.0.0.1:8800 {
				lb_try_duration {$OMB_CLOUD_EDGE_HOLD:0s}
				lb_try_interval 50ms
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {client_ip}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:8799 {
				lb_try_duration {$OMB_CLOUD_EDGE_HOLD:0s}
				lb_try_interval 50ms
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {client_ip}
				# the event stream must not be buffered
				flush_interval -1
			}
		}
	}

	handle {
		respond 403
	}
}
