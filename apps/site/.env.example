# landing site (server.js landing) env. real values: ~/.config/duskbot/site-landing.env, uploaded by deploy.sh
# waitlist store: mongodb when MONGODB_URI is set, else a jsonl file at DUSK_WAITLIST_FILE (keep it outside the app folder)
MONGODB_URI=mongodb://dusk:<password>@127.0.0.1:29018/dusk?authSource=admin
MONGODB_DB=dusk
DUSK_WAITLIST_FILE=/root/dusk-data/waitlist.jsonl
# new signups are added to this brevo list (key needs the contacts permission; list id from brevo-setup.mjs)
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
