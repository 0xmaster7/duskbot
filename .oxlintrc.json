{
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist/**",
    "dist-electron/**",
    "dist-native/**",
    "dist-server/**",
    "electron/vendor/**",
    "release/**",
    "third_party/**",
    "electron/resources/**"
  ],
  "overrides": [
    {
      "files": [
        "apps/dashboard/tracker/*.js"
      ],
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "caughtErrors": "none"
          }
        ]
      }
    }
  ]
}
