# Dusk Bot account service (apps/dashboard/server, with the managed cloud in apps/cloud-service) on app.dusk.bot.
# Names and what they do; no values. Copy to a 0600 file outside the repo, fill in, and pass it to deploy with
# --env-file. Never commit the filled copy. Staging (dev.dusk.bot) uses its own copy: see docs/LAUNCH.md.
# scripts/account-env-template.test.ts fails when the service reads a name this file does not list.

# --- service ---
# public origin; sets cookie Secure, CORS and the OAuth callback base. https://app.dusk.bot (staging: https://dev.dusk.bot)
DUSK_DASHBOARD_PUBLIC_URL=
# listen address; keep loopback, nginx (deployd) proxies to it
DUSK_DASHBOARD_HOST=127.0.0.1
# listen port; deployd writes PORT, the deploy command maps it: DUSK_DASHBOARD_PORT=$PORT
DUSK_DASHBOARD_PORT=
# data folder (accounts, sessions, workspaces, billing, clouds); back it up (deploy/account/backup.sh). e.g. /var/lib/dusk-account
DUSK_DASHBOARD_DATA=
# built page folder; defaults to apps/dashboard/dist after pnpm build:dashboard
DUSK_DASHBOARD_STATIC=
# 1 behind the deployd nginx proxy, so rate limits see the proxy's own X-Forwarded-For entry
DUSK_TRUST_PROXY=1
# production | staging; tags error reports
DUSK_ENVIRONMENT=
# 1 only for local development (console mail, fake providers); never in production
DUSK_DASHBOARD_DEV=
# HMAC secret for CSRF tokens and codes, 32+ characters; if empty the service makes data/auth-secret itself
DUSK_AUTH_SECRET=
# 0 closes new sign-ups (existing accounts still sign in)
DUSK_AUTH_SIGNUP_OPEN=
# where crashes and 500s go: a Sentry-compatible DSN (self-hosted GlitchTip or sentry.io); empty turns reporting off
DUSK_ERROR_DSN=

# --- email (sign-in codes, notices) ---
# resend in production
DUSK_MAIL_PROVIDER=resend
# Resend API key (sending only, restricted to the dusk.bot domain)
DUSK_RESEND_API_KEY=
# sender, e.g. Dusk Bot <account@dusk.bot> (domain verified in Resend: SPF, DKIM, DMARC)
DUSK_MAIL_FROM=
# operator inbox for cloud lifecycle alerts (destroy, suspend, payment problems)
DUSK_OPS_ALERT_EMAIL=
# 32+ characters; turns on GET /v1/billing/ops/funnel for the operator; empty removes the route
DUSK_OPS_TOKEN=

# --- sign-in providers (optional; setting any name of a provider requires all of its required ones) ---
# Google: OAuth client for https://app.dusk.bot/v1/auth/oauth/google/callback
DUSK_AUTH_GOOGLE_CLIENT_ID=
DUSK_AUTH_GOOGLE_CLIENT_SECRET=
# Apple: Services ID, team, key id and the .p8 key (inline with \n, or a 0600 file path)
DUSK_AUTH_APPLE_CLIENT_ID=
DUSK_AUTH_APPLE_TEAM_ID=
DUSK_AUTH_APPLE_KEY_ID=
DUSK_AUTH_APPLE_PRIVATE_KEY=
DUSK_AUTH_APPLE_PRIVATE_KEY_FILE=
# X: OAuth 2 client; secret optional for a public client; scopes default to users.read tweet.read
DUSK_AUTH_X_CLIENT_ID=
DUSK_AUTH_X_CLIENT_SECRET=
DUSK_AUTH_X_SCOPES=

# --- billing (Dodo Payments, merchant of record) ---
# dodo in production; empty means billing off (plans cannot be bought)
DUSK_BILLING_PROVIDER=
# test on staging, live on production
DUSK_DODO_MODE=
# Dodo API key for that mode
DUSK_DODO_API_KEY=
# webhook signing secret for https://app.dusk.bot/v1/billing/webhooks/dodo (whsec_...)
DUSK_DODO_WEBHOOK_SECRET=
# JSON map of plan ids to Dodo product ids (shared/billing-api.ts lists the plan ids)
DUSK_DODO_PRODUCTS=
# optional: until this ISO date work use is free (launch promotion)
DUSK_FREE_WORK_UNTIL=
# Ed25519 key that signs plan entitlements (kid:<pkcs8 base64url>; apps/cloud-service/scripts/keygen.mjs); its public half is pinned in shared/entitlement.ts
DUSK_ENTITLEMENT_SIGNING_KEY=

# --- cloud desktops (optional) ---
# 1 attaches the managed cloud (apps/cloud-service); needs the names below
DUSK_MANAGED=
# runtime key of the cloud desktop provider (never the template key)
BOAT_API_KEY=
# only in the release CI, never here; the service refuses to start if it equals BOAT_API_KEY
BOAT_TEMPLATE_API_KEY=
# provider API base override (tests and staging only)
BOAT_BASE_URL=
# sealing key for cloud bootstrap secrets, link keys and Slack edge tokens at rest (base64url 32 bytes)
DUSK_CLOUD_SEAL_KEY=
# key that seals cloud backups; derived from DUSK_CLOUD_SEAL_KEY when empty; _PREVIOUS opens backups made before a rotation
DUSK_MANAGED_BACKUP_KEY=
DUSK_MANAGED_BACKUP_KEY_PREVIOUS=
# folder for sealed cloud backups (default <data>/boat-backups)
DUSK_MANAGED_BACKUP_DIR=
# shared with the public edge Worker (EDGE_TOKEN) for its route lookup
DUSK_MANAGED_EDGE_TOKEN=
# public name suffix of cloud desktops, e.g. cloud.dusk.bot
DUSK_MANAGED_PUBLIC_DOMAIN=
# desktop kinds offered (default shared_s,shared_m,dedicated) and the smallest machine size
DUSK_MANAGED_KINDS=
DUSK_MANAGED_SMALLEST=
# provider label scope that marks our machines (default from the public URL)
DUSK_MANAGED_SCOPE=
# signed template snapshot and its release signature (from the release CI)
DUSK_MANAGED_TEMPLATE=
DUSK_MANAGED_TEMPLATE_SIGNATURE=
# the home package a machine installs: URL or file, its sha256 and release signature (inline or file)
DUSK_MANAGED_HOME_PACKAGE_URL=
DUSK_MANAGED_HOME_PACKAGE_FILE=
DUSK_MANAGED_HOME_PACKAGE_SHA256=
DUSK_MANAGED_HOME_PACKAGE_SIGNATURE=
DUSK_MANAGED_HOME_PACKAGE_SIGNATURE_FILE=
# extra release public keys (kid:x,...) for staging builds; empty in production
DUSK_RELEASE_PUBLIC_KEYS=
# 1 only for the e2e harness against .test/.invalid hosts
DUSK_MANAGED_TEST_HARNESS=
# dedicated desktops on another provider: hetzner plus its API token; fake only on loopback
DUSK_CLOUD_PROVIDER=
DUSK_HETZNER_TOKEN=
# the cloud desktop image and public origin template, e.g. https://{id}.cloud.dusk.bot
DUSK_CLOUD_HOME_IMAGE=
DUSK_CLOUD_ORIGIN_TEMPLATE=
# shared pool desktops: fake only on loopback; empty in production until a pool driver exists
DUSK_POOL_DRIVER=
# 1 lets sleeping cloud desktops keep their Slack bots (needs DUSK_CLOUD_SEAL_KEY)
DUSK_SLACK_EDGE=
