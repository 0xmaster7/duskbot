[Unit]
Description=dusk bot account service backup (encrypted, off-box)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# DUSK_DASHBOARD_DATA, DUSK_BACKUP_RECIPIENT, DUSK_BACKUP_DEST (and the rclone remote's own config) live here, mode 0600
EnvironmentFile=/etc/dusk-account/backup.env
ExecStart=/opt/dusk-account/backup.sh
Nice=10
IOSchedulingClass=idle
