# managed by openmausbot-link
[Unit]
Description=OpenMausBot docker gate (the server's only way to docker)
After=docker.service

[Service]
Type=simple
User=omb-docker
Group=omb-dockergate
SupplementaryGroups=docker
RuntimeDirectory=openmausbot-docker
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/bin/node /usr/local/lib/openmausbot/docker-gate.mjs
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
# no MemoryDenyWriteExecute: node's JIT needs writable executable memory

[Install]
WantedBy=multi-user.target
